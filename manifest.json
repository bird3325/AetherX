{
  "manifest_version": 3,
  "name": "셀러보드X - 셀러를 위한 분석 보드",
  "version": "1.0.0",
  "description": "중급 셀러를 위한 초경량 실시간 분석 & 원클릭 소싱 인텔리전스",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.pstatic.net/*",
    "https://*.coupangcdn.com/*",
    "https://*.1688.com/*",
    "https://*.aliexpress.com/*",
    "https://*.gmarket.co.kr/*",
    "https://*.auction.co.kr/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "셀러보드X - 셀러를 위한 분석 보드",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://search.shopping.naver.com/*",
        "https://www.coupang.com/*",
        "https://*.gmarket.co.kr/*",
        "https://*.auction.co.kr/*"
      ],
      "css": [
        "styles/overlay.css"
      ],
      "js": [
        "subagents/naverParser.js",
        "subagents/coupangParser.js",
        "subagents/gmarketParser.js",
        "subagents/auctionParser.js",
        "subagents/calculator.js",
        "subagents/uiRenderer.js",
        "content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://s.1688.com/*"
      ],
      "js": [
        "1688content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://s.1688.com/*"
      ],
      "js": [
        "1688main.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.aliexpress.com/*"
      ],
      "css": [
        "styles/overlay.css"
      ],
      "js": [
        "aliexpresscontent.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.aliexpress.com/*"
      ],
      "js": [
        "aliexpressmain.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ]
}
